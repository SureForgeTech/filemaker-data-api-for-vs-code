{
  "name": "@fmweb/designer-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --platform=browser --format=iife --outfile=dist/index.js --minify --define:process.env.NODE_ENV=\\\"production\\\"",
    "dev": "esbuild src/main.tsx --bundle --platform=browser --format=iife --outfile=dist/index.js --sourcemap --define:process.env.NODE_ENV=\\\"development\\\" --watch",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fmweb/shared": "file:../shared",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2"
  }
}
